# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#   cp .env.example .env
#
# The database defaults below match docker-compose.yml, so after
# `docker compose up -d` they work as-is for local development.

# --- Database (PostgreSQL) ------------------------------------------------
# App connection used at runtime. In production this should be a LIMITED role
# (row DML only); for local dev the docker superuser is fine.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/petty_cash

# Owner/admin connection used by drizzle-kit (db:push / db:studio) and the seed
# scripts, which need DDL. Locally this can be the same superuser.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/petty_cash

# --- Better Auth ----------------------------------------------------------
# A long random secret that signs sessions. Generate one, e.g.:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# The app's base URL. Match your dev server (TanStack Start defaults to :3000).
BETTER_AUTH_URL=http://localhost:3000

# --- Gemini OCR (Google AI Studio) ---------------------------------------
# Server-side only — never exposed to the browser. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional: pin a model. Defaults to `gemini-flash-latest` if unset.
# GEMINI_MODEL=gemini-flash-latest

# --- Redis ----------------------------------------------------------------
# Provided by docker-compose for local dev. Not yet used by the app — present
# so the environment is ready when caching/queues are added.
# REDIS_URL=redis://localhost:6379

# --- Supabase build only --------------------------------------------------
# The `backend-supabase-included` branch also needs these (receipt Storage).
# The pure-Postgres build (this branch) does not.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
