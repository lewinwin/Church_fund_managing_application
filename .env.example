# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#   cp .env.example .env
#
# The database defaults below match docker-compose.yml, so after
# `docker compose up -d` they work as-is for local development.

# --- Database (PostgreSQL) ------------------------------------------------
# App connection used at runtime. In production this should be a LIMITED role
# (row DML only); for local dev the docker superuser is fine.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/petty_cash

# Owner/admin connection used by drizzle-kit (db:push / db:studio) and the seed
# scripts, which need DDL. Locally this can be the same superuser.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/petty_cash

# --- Better Auth ----------------------------------------------------------
# A long random secret that signs sessions. Generate one, e.g.:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# The app's base URL. Match your dev server (TanStack Start defaults to :3000).
BETTER_AUTH_URL=http://localhost:3000

# --- Receipt OCR provider (developer config, no user-facing selector) -----
# Which engine verifies receipts:
#   gemini    → cloud Google Gemini (needs GEMINI_API_KEY below). Default.
#   tesseract → fully local Tesseract + bundled English data (tessdata/), plus
#               PDF text-layer / page-render. No API key, no network.
OCR_PROVIDER=gemini

# --- Gemini OCR (Google AI Studio) — only needed when OCR_PROVIDER=gemini --
# Server-side only — never exposed to the browser. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional: pin a model. Defaults to `gemini-flash-latest` if unset.
# GEMINI_MODEL=gemini-flash-latest

# --- Receipt object storage (S3-compatible) -------------------------------
# Receipt images are stored in object storage (not the DB) and viewed via
# short-lived presigned URLs from a PRIVATE bucket. Same code for every backend
# — only these vars change.
#   Local dev: MinIO — `docker compose up -d minio`, OR the standalone binary
#              (no Docker) then `bun run s3:init` to create the bucket.
#   Production: Cloudflare R2 (endpoint https://<acct>.r2.cloudflarestorage.com,
#              region "auto") or AWS S3 / Supabase S3.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET=receipts
S3_REGION=us-east-1

# --- Redis ----------------------------------------------------------------
# Provided by docker-compose for local dev. Not yet used by the app — present
# so the environment is ready when caching/queues are added.
# REDIS_URL=redis://localhost:6379

# --- Supabase build only --------------------------------------------------
# The `backend-supabase-included` branch also needs these (receipt Storage).
# The pure-Postgres build (this branch) does not.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
